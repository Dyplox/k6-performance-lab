{
  // Scripts de Node (comparación con la línea base). Node >= 22.18 los ejecuta sin compilar,
  // por eso solo se permite sintaxis "borrable" (sin enums ni namespaces).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./*.ts"]
}
